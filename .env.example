SEVERA_CLIENT_ID=
SEVERA_CLIENT_SECRET=
SEVERA_SCOPE=customers:read projects:read invoices:read hours:read travels:read fees:read activities:read users:read organization:read settings:read files:read resourceallocations:read
# SEVERA_ACCESS_TOKEN=
SEVERA_BASE_URL=https://api.severa.visma.com/rest-api
SEVERA_TIMEOUT_MS=30000
# SEVERA_AUDIT_LOG=/absolute/path/to/severa-audit.jsonl

# Optional governed writes:
# SEVERA_ENABLE_WRITES=false
# SEVERA_POLICY_PATH=/absolute/path/to/severa-policy.json
# HMAC key for prepared write requests (random per process when unset):
# SEVERA_PREPARE_SECRET=

# Streamable HTTP transport. MCP_HTTP_TOKEN is required for a non-loopback bind
# or MCP_ALLOW_ANY_ORIGIN=true: at least 32 printable ASCII characters,
# e.g. `openssl rand -hex 32`.
MCP_HTTP_HOST=127.0.0.1
PORT=3000
MCP_MAX_BODY_BYTES=10485760
# MCP_HTTP_TOKEN=
# MCP_ALLOWED_ORIGINS=https://your-local-client.example
# MCP_ALLOW_ANY_ORIGIN=false
# MCP_ALLOWED_HOSTS=
# MCP_AUTH_FAILURE_LIMIT=20
# MCP_AUTH_FAILURE_WINDOW_MS=60000
# Serve /mcp without a token on a non-loopback bind (only if access is restricted otherwise):
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false
