SEVERA_CLIENT_ID=
SEVERA_CLIENT_SECRET=
SEVERA_SCOPE=customers:read projects:read invoices:read hours:read travels:read fees:read activities:read users:read organization:read settings:read files:read resourceallocations:read
# SEVERA_ACCESS_TOKEN=
SEVERA_BASE_URL=https://api.severa.visma.com/rest-api
SEVERA_TIMEOUT_MS=30000
# SEVERA_AUDIT_LOG=/absolute/path/to/severa-audit.jsonl

# Optional governed writes:
# SEVERA_ENABLE_WRITES=false
# SEVERA_POLICY_PATH=/absolute/path/to/severa-policy.json

# Optional Streamable HTTP hardening:
MCP_HTTP_HOST=127.0.0.1
PORT=3000
MCP_MAX_BODY_BYTES=10485760
